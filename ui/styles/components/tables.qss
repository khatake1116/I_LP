/* ==========================================================
   TABLES
   ========================================================== */

QTableView,
QTableWidget {

    background-color: #FFFFFF;
    color: #2C3E50;

    alternate-background-color: #F8FAFC;

    gridline-color: #E1E7EC;

    border: 1px solid #CBD5E1;
    border-radius: 8px;

    selection-background-color: #D9EAF8;
    selection-color: #1F2D3D;

    outline: none;

    font-family: "Segoe UI";
    font-size: 13px;
}


/* --- FILAS --- */

QTableView::item,
QTableWidget::item {
    padding: 6px;
    border: none;
}

QTableView::item:hover,
QTableWidget::item:hover {
    background-color: #F2F6F8;
}


/* --- CABECERAS --- */

QHeaderView::section {

    background-color: #F1F5F8;
    color: #34495E;

    padding: 8px 10px;

    border: none;
    border-bottom: 1px solid #CBD5E1;

    font-family: "Segoe UI";
    font-size: 12px;
    font-weight: 600;
}


/* --- TABLA DE VENTAS --- */

QTableWidget#SalesTable {
    background-color: #FFFFFF;
    alternate-background-color: #F7FAFC;

    border: 1px solid #CBD5E1;
    border-radius: 8px;

    selection-background-color: #D9EAF8;
    selection-color: #1F2D3D;
}


/* --- CARRITO POS --- */

QTableWidget#PosCartTable {

    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;

    color: #2C3E50;

    gridline-color: #E1E7EC;

    border: 1px solid #CBD5E1;
    border-radius: 8px;

    selection-background-color: #D9EAF8;
    selection-color: #1F2D3D;
}


/* --- ITEMS DE ENVÍOS --- */

QTableWidget#ShipmentItemsTable {

    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;

    color: #2C3E50;

    gridline-color: #E1E7EC;

    border: 1px solid #CBD5E1;
    border-radius: 6px;

    selection-background-color: #D9EAF8;
    selection-color: #1F2D3D;
}


/* --- ESTADOS DE SELECCIÓN --- */

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: #D9EAF8;
    color: #1F2D3D;
}


/* --- SCROLLBAR DE TABLAS --- */

QTableView QScrollBar:vertical,
QTableWidget QScrollBar:vertical {

    background-color: #F1F5F8;
    width: 8px;

    margin: 1px;
    border-radius: 4px;
}

QTableView QScrollBar::handle:vertical,
QTableWidget QScrollBar::handle:vertical {

    background-color: #B8C4CE;

    min-height: 30px;

    border-radius: 4px;
}

QTableView QScrollBar::handle:vertical:hover,
QTableWidget QScrollBar::handle:vertical:hover {
    background-color: #3498DB;
}

QTableView QScrollBar::add-line:vertical,
QTableView QScrollBar::sub-line:vertical,
QTableWidget QScrollBar::add-line:vertical,
QTableWidget QScrollBar::sub-line:vertical {
    height: 0;
}