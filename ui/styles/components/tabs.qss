/* ==========================================================
   TABS
   ========================================================== */

QTabWidget {
    background-color: transparent;
    border: none;
}


/* --- PANEL --- */

QTabWidget::pane {

    background-color: #FFFFFF;

    border: 1px solid #CBD5E1;
    border-radius: 8px;

    top: -1px;
}


/* --- TAB BASE --- */

QTabBar::tab {

    background-color: #EAF0F4;
    color: #5D6D7E;

    border: 1px solid #CBD5E1;
    border-bottom: none;

    padding: 8px 16px;

    margin-right: 3px;

    border-top-left-radius: 6px;
    border-top-right-radius: 6px;

    font-family: "Segoe UI";
    font-size: 13px;
    font-weight: 500;
}


/* --- HOVER --- */

QTabBar::tab:hover:!selected {

    background-color: #DDE8EF;
    color: #2C3E50;
}


/* --- ACTIVA --- */

QTabBar::tab:selected {

    background-color: #3498DB;
    color: #FFFFFF;

    border-color: #3498DB;

    font-weight: 600;
}


/* ==========================================================
   SALES
   ========================================================== */

QTabWidget#SalesTabs::pane,
QTabWidget#LogisticsTabs::pane,
QTabWidget#InventoryTabs::pane,
QTabWidget#PurchasesTabs::pane {

    background-color: #FFFFFF;

    border: 1px solid #CBD5E1;
    border-radius: 8px;

    top: -1px;
}


QTabWidget#SalesTabs QTabBar::tab,
QTabWidget#LogisticsTabs QTabBar::tab,
QTabWidget#InventoryTabs QTabBar::tab,
QTabWidget#PurchasesTabs QTabBar::tab {

    background-color: #EAF0F4;
    color: #5D6D7E;

    border: 1px solid #CBD5E1;
    border-bottom: none;

    padding: 8px 16px;

    margin-right: 3px;

    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}


QTabWidget#SalesTabs QTabBar::tab:hover,
QTabWidget#LogisticsTabs QTabBar::tab:hover,
QTabWidget#InventoryTabs QTabBar::tab:hover,
QTabWidget#PurchasesTabs QTabBar::tab:hover {

    background-color: #DDE8EF;
    color: #2C3E50;
}


QTabWidget#SalesTabs QTabBar::tab:selected,
QTabWidget#LogisticsTabs QTabBar::tab:selected,
QTabWidget#InventoryTabs QTabBar::tab:selected,
QTabWidget#PurchasesTabs QTabBar::tab:selected {

    background-color: #3498DB;
    color: #FFFFFF;

    border-color: #3498DB;

    font-weight: 600;
}