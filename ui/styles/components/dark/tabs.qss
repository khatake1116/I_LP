   ATENCION: archivo GENERADO automaticamente.
   Fuente: ui/styles/components/tabs.qss
   Herramienta: scripts/generate_dark_components.py
   No editar a mano: regenerar tras cambiar el componente claro.
   ========================================================== */

/* ==========================================================
   TABS
   ========================================================== */

QTabWidget {
    background-color: transparent;
    border: none;
}


/* --- PANEL --- */

QTabWidget::pane {

    background-color: #1E1E2E;

    border: 1px solid #313244;
    border-radius: 8px;

    top: -1px;
}


/* --- TAB BASE --- */

QTabBar::tab {

    background-color: #1E1E2E;
    color: #A6ADC8;

    border: 1px solid #313244;
    border-bottom: none;

    padding: 8px 16px;

    margin-right: 3px;

    border-top-left-radius: 6px;
    border-top-right-radius: 6px;

    font-family: "Segoe UI";
    font-size: 13px;
    font-weight: 500;
}


/* --- HOVER --- */

QTabBar::tab:hover:!selected {

    background-color: #313244;
    color: #CDD6F4;
}


/* --- ACTIVA --- */

QTabBar::tab:selected {

    background-color: #89B4FA;
    color: #1E1E2E;

    border-color: #89B4FA;

    font-weight: 600;
}


/* ==========================================================
   SALES
   ========================================================== */

QTabWidget#SalesTabs::pane,
QTabWidget#LogisticsTabs::pane,
QTabWidget#InventoryTabs::pane,
QTabWidget#PurchasesTabs::pane {

    background-color: #1E1E2E;

    border: 1px solid #313244;
    border-radius: 8px;

    top: -1px;
}


QTabWidget#SalesTabs QTabBar::tab,
QTabWidget#LogisticsTabs QTabBar::tab,
QTabWidget#InventoryTabs QTabBar::tab,
QTabWidget#PurchasesTabs QTabBar::tab {

    background-color: #1E1E2E;
    color: #A6ADC8;

    border: 1px solid #313244;
    border-bottom: none;

    padding: 8px 16px;

    margin-right: 3px;

    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}


QTabWidget#SalesTabs QTabBar::tab:hover,
QTabWidget#LogisticsTabs QTabBar::tab:hover,
QTabWidget#InventoryTabs QTabBar::tab:hover,
QTabWidget#PurchasesTabs QTabBar::tab:hover {

    background-color: #313244;
    color: #CDD6F4;
}


QTabWidget#SalesTabs QTabBar::tab:selected,
QTabWidget#LogisticsTabs QTabBar::tab:selected,
QTabWidget#InventoryTabs QTabBar::tab:selected,
QTabWidget#PurchasesTabs QTabBar::tab:selected {

    background-color: #89B4FA;
    color: #1E1E2E;

    border-color: #89B4FA;

    font-weight: 600;
}