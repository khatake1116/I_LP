/* ==========================================================
   ATENCION: archivo GENERADO automaticamente.
   Fuente: ui/styles/components/dashboard.qss
   Herramienta: scripts/generate_dark_components.py
   No editar a mano: regenerar tras cambiar el componente claro.
   ========================================================== */

/* ==========================================================
   dashboard / pos
   windows 10/11 professional
   ========================================================== */


/* ==========================================================
   dashboard
   ========================================================== */

qlabel#dashboardtitle {

    color: #cdd6f4;

    font-size: 22px;
    font-weight: 700;
}

qlabel#dashboardsubtitle,
qlabel#metriccaption {

    color: #a6adc8;
    font-size: 12px;
}


qlabel#dashboardsectiontitle {

    color: #b4befe;

    font-size: 16px;
    font-weight: 600;

    margin-top: 8px;
    margin-bottom: 4px;
}


/* --- tarjetas de métricas --- */

qframe#metriccard {

    background-color: #1e1e2e;

    border: 1px solid #313244;
    border-radius: 8px;

    min-height: 84px;
}


qlabel#metricvalue {

    color: #89b4fa;

    font-size: 22px;
    font-weight: 700;
}


/* --- footer --- */

qframe#dashboardfooter {

    background-color: #1e1e2e;

    border-top: 1px solid #313244;
}


qlabel#dashboardclock {

    color: #a6adc8;

    font-family: "courier new";
    font-size: 11px;
}


/* ==========================================================
   pos
   ========================================================== */

qwidget#posshell {

    background-color: #181825;

    border: 1px solid #313244;
    border-radius: 10px;
}


/* --- header --- */

qframe#posheader {

    background-color: #1e1e2e;

    border: 1px solid #313244;
    border-radius: 8px;
}


qlabel#postitle {

    color: #cdd6f4;

    font-size: 22px;
    font-weight: 700;
}


qlabel#possubtitle {

    color: #a6adc8;

    font-size: 11px;
}


/* --- estado --- */

qlabel#posstatusbadge {

    background-color: #2e9b65;
    color: #1e1e2e;

    border-radius: 14px;

    min-width: 72px;
    min-height: 28px;

    font-weight: 600;
}


/* --- métricas pos --- */

qframe#posmetriccard {

    background-color: #1e1e2e;

    border: 1px solid #313244;
    border-radius: 8px;

    min-height: 84px;
}


qlabel#posmetriclabel {

    color: #a6adc8;
    font-size: 11px;
}


qlabel#posmetricvalue {

    color: #89b4fa;

    font-size: 22px;
    font-weight: 700;
}


/* --- paneles --- */

qframe#pospanel {

    background-color: #1e1e2e;

    border: 1px solid #313244;
    border-radius: 8px;
}


qlabel#pospaneltitle {

    color: #b4befe;

    font-size: 14px;
    font-weight: 600;
}


/* --- bloques de información --- */

qframe#posinfoblock,
qframe#possummaryblock {

    background-color: #181825;

    border: 1px solid #313244;
    border-radius: 8px;
}


/* --- total --- */

qlabel#postotalvalue {

    color: #f9e2af;

    font-size: 28px;
    font-weight: 700;
}


/* ==========================================================
   perfil
   ========================================================== */

qlabel#profileavatar {

    background-color: #89b4fa;
    color: #1e1e2e;

    border-radius: 18px;

    font-weight: 700;
}


qlabel#profilecompany {

    color: #cdd6f4;

    font-size: 12px;
    font-weight: 600;
}


qlabel#profilebranch {

    color: #a6adc8;

    font-size: 11px;
}


/* ==========================================================
   moneda
   ========================================================== */

qlabel#exchangeratelabel {

    color: #89b4fa;

    background-color: #1e1e2e;

    border: 1px solid #45475a;
    border-radius: 5px;

    padding: 5px 7px;

    font-size: 11px;
    font-weight: 600;
}


qcombobox#currencycombo {

    min-width: 58px;

    background-color: #1e1e2e;
    color: #cdd6f4;

    border: 1px solid #45475a;
    border-radius: 5px;

    padding: 5px 8px;
}


/* ==========================================================
   sales
   ========================================================== */

qwidget#salesshell {

    background-color: #181825;

    border: 1px solid #313244;
    border-radius: 10px;
}


qframe#salesheader {

    background-color: #1e1e2e;

    border: 1px solid #313244;
    border-radius: 8px;
}


qlabel#salesheadertitle {

    color: #b4befe;

    font-size: 18px;
    font-weight: 700;
}


qlabel#salestotalvalue,
qlabel#salesfiltertotal {

    color: #89b4fa;

    font-size: 15px;
    font-weight: 700;
}


/* ==========================================================
   filtros / contenedores
   ========================================================== */

qframe#filterframe,
qframe#calendarcontainer {

    background-color: #1e1e2e;

    border: 1px solid #313244;
    border-radius: 8px;

    margin: 4px 0;
}


/* ==========================================================
   alertas
   ========================================================== */

qlabel#alertalabel {

    font-size: 13px;
    font-weight: 600;

    padding: 9px;

    background-color: #181825;

    border: 1px solid #313244;
    border-radius: 7px;
}


qlabel#alertalabel[alertlevel="normal"] {

    color: #a6e3a1;
    background-color: #1e2e24;
}


qlabel#alertalabel[alertlevel="error"] {

    color: #f38ba8;
    background-color: #2a1e28;
}


/* ==========================================================
   reloj
   ========================================================== */

qlabel#digitalclock {

    font-family: "courier new";

    font-size: 28px;
    font-weight: 700;

    color: #b4befe;

    background-color: #1e1e2e;

    padding: 10px;

    border-radius: 8px;
    border: 1px solid #313244;
}


/* ==========================================================
   splash
   ========================================================== */

qwidget#splashscreen {

    background-color: #1e1e2e;

    border: 1px solid #313244;
    border-radius: 10px;
}


qlabel#splashtitle {

    color: #b4befe;

    font-size: 20px;
    font-weight: 700;

    background: transparent;
}


qlabel#splashloading,
qlabel#notificationsinfo {

    color: #a6adc8;

    font-size: 12px;

    background: transparent;
}


qprogressbar#splashprogress {

    background-color: #313244;

    border: none;
    border-radius: 3px;
}


qprogressbar#splashprogress::chunk {

    background-color: #89b4fa;

    border-radius: 3px;
}


qlabel#notificationsempty {

    color: #11111b;

    font-size: 15px;
    font-style: italic;

    padding: 40px;
}


/* ==========================================================
   scrollbar general
   ========================================================== */

qscrollbar:vertical {

    background-color: #181825;

    width: 8px;

    margin: 2px 0;
    border-radius: 4px;
}


qscrollbar::handle:vertical {

    background-color: #45475a;

    min-height: 32px;

    border-radius: 4px;
}


qscrollbar::handle:vertical:hover {
    background-color: #89b4fa;
}


qscrollbar::add-line:vertical,
qscrollbar::sub-line:vertical {

    height: 0;
    border: none;
}